{
  "rules": {
    ".read": false,
    ".write": false,
    "brepline": {
      "generations": {
        "$id": {
          ".read": false,
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['schema','job','prompt','code'])"
        }
      },
      "failures":  { ".read": false, "$job": { "$push": { ".write": "!data.exists()" } } },
      "feedback":  { ".read": false, "$job": { "$push": { ".write": "!data.exists()" } } }
    }
  }
}
